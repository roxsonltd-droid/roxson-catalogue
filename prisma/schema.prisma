generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id       Int       @id @default(autoincrement())
  slug     String    @unique
  num      Int       @default(0)
  titleEn  String
  titleBg  String
  blurbEn  String
  blurbBg  String
  products Product[]
}

model Product {
  id                  Int                 @id @default(autoincrement())
  sku                 String              @unique
  slug                String              @unique
  supplierCode        String?
  seriesEn            String
  seriesBg            String
  descEn              String
  descBg              String
  materialEn          String              @default("")
  materialBg          String              @default("")
  diameterMin         Float?
  diameterMax         Float?
  diameterUnit        DiameterUnit        @default(INCH)
  unit                String              @default("m")
  moq                 Float?
  packLength          Float?
  layout              String              @default("ruler")
  coreEn              String              @default("")
  coreBg              String              @default("")
  insulationEn        String              @default("")
  insulationBg        String              @default("")
  jacketEn            String              @default("")
  jacketBg            String              @default("")
  applicationEn       String              @default("")
  applicationBg       String              @default("")
  standardEn          String              @default("")
  standardBg          String              @default("")
  standardHighlight   Boolean             @default(false)
  imageUrl            String
  datasheetUrl        String?
  searchText          String              @default("")
  order               Int                 @default(0)
  isActive            Boolean             @default(true)
  technicalDataStatus TechnicalDataStatus @default(UNREVIEWED)
  categoryId          Int
  category            Category            @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  inquiryItems        InquiryItem[]
  quoteItems          QuoteItem[]

  @@index([categoryId])
  @@index([isActive])
  @@index([technicalDataStatus])
}

model Inquiry {
  id             Int               @id @default(autoincrement())
  company        String?
  contactName    String
  email          String
  phone          String?
  country        String?
  message        String?
  status         InquiryStatus     @default(NEW)
  nextAction     String?
  nextActionAt   DateTime?
  lastActivityAt DateTime          @default(now())
  items          InquiryItem[]
  quotes         Quote[]
  notes          InquiryNote[]
  activities     InquiryActivity[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([email])
  @@index([nextActionAt])
  @@index([lastActivityAt])
}

model InquiryNote {
  id        Int      @id @default(autoincrement())
  inquiryId Int
  inquiry   Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  body      String
  author    String?
  createdAt DateTime @default(now())

  @@index([inquiryId, createdAt])
}

model InquiryActivity {
  id          Int                 @id @default(autoincrement())
  inquiryId   Int
  inquiry     Inquiry             @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  type        InquiryActivityType
  description String
  actor       String?
  metadata    Json?
  createdAt   DateTime            @default(now())

  @@index([inquiryId, createdAt])
  @@index([type])
}

model InquiryItem {
  id           Int          @id @default(autoincrement())
  inquiryId    Int
  inquiry      Inquiry      @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  productId    Int
  product      Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  diameter     Float?
  diameterUnit DiameterUnit
  quantity     Float
  unit         String       @default("m")
  notes        String?

  @@index([inquiryId])
  @@index([productId])
}

model Quote {
  id            Int         @id @default(autoincrement())
  inquiryId     Int
  inquiry       Inquiry     @relation(fields: [inquiryId], references: [id], onDelete: Restrict)
  version       Int         @default(1)
  status        QuoteStatus @default(DRAFT)
  currency      String      @default("EUR")
  subtotal      Decimal     @default(0) @db.Decimal(14, 2)
  freight       Decimal     @default(0) @db.Decimal(14, 2)
  discount      Decimal     @default(0) @db.Decimal(14, 2)
  total         Decimal     @default(0) @db.Decimal(14, 2)
  validUntil    DateTime?
  paymentTerms  String?
  deliveryTerms String?
  notes         String?
  sentAt        DateTime?
  emailedAt     DateTime?
  sentToEmail   String?
  pdfHash       String?
  items         QuoteItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([inquiryId, version])
  @@index([status])
  @@index([createdAt])
}

model QuoteItem {
  id           Int           @id @default(autoincrement())
  quoteId      Int
  quote        Quote         @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId    Int?
  product      Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  sku          String
  supplierCode String?
  description  String
  diameter     Float?
  diameterUnit DiameterUnit?
  quantity     Decimal       @db.Decimal(14, 3)
  unit         String
  unitPrice    Decimal       @db.Decimal(14, 4)
  lineTotal    Decimal       @db.Decimal(14, 2)
  notes        String?

  @@index([quoteId])
  @@index([productId])
}

enum InquiryStatus {
  NEW
  REVIEWING
  QUOTED
  NEGOTIATING
  WON
  LOST
}

enum InquiryActivityType {
  CREATED
  STATUS_CHANGED
  NOTE_ADDED
  NEXT_ACTION_UPDATED
  QUOTE_CREATED
  QUOTE_UPDATED
  QUOTE_FINALIZED
  QUOTE_EMAILED
}

enum DiameterUnit {
  MM
  INCH
}

enum TechnicalDataStatus {
  UNREVIEWED
  NEEDS_VERIFICATION
  VERIFIED
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  SUPERSEDED
}

model Admin {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}
