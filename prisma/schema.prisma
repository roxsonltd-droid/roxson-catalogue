generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id       Int       @id @default(autoincrement())
  slug     String    @unique
  num      Int       @default(0)
  titleEn  String
  titleBg  String
  blurbEn  String
  blurbBg  String
  products Product[]
}

model Product {
  id                  Int                 @id @default(autoincrement())
  sku                 String              @unique
  slug                String              @unique
  supplierCode        String?
  seriesEn            String
  seriesBg            String
  descEn              String
  descBg              String
  materialEn          String              @default("")
  materialBg          String              @default("")
  diameterMin         Float?
  diameterMax         Float?
  diameterUnit        DiameterUnit        @default(INCH)
  unit                String              @default("m")
  moq                 Float?
  packLength          Float?
  layout              String              @default("ruler")
  coreEn              String              @default("")
  coreBg              String              @default("")
  insulationEn        String              @default("")
  insulationBg        String              @default("")
  jacketEn            String              @default("")
  jacketBg            String              @default("")
  applicationEn       String              @default("")
  applicationBg       String              @default("")
  standardEn          String              @default("")
  standardBg          String              @default("")
  standardHighlight   Boolean             @default(false)
  imageUrl            String
  datasheetUrl        String?
  searchText          String              @default("")
  order               Int                 @default(0)
  isActive            Boolean             @default(true)
  technicalDataStatus TechnicalDataStatus @default(UNREVIEWED)
  categoryId          Int
  category            Category            @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  inquiryItems        InquiryItem[]

  @@index([categoryId])
  @@index([isActive])
  @@index([technicalDataStatus])
}

model Inquiry {
  id          Int           @id @default(autoincrement())
  company     String?
  contactName String
  email       String
  phone       String?
  country     String?
  message     String?
  status      InquiryStatus @default(NEW)
  items       InquiryItem[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([email])
}

model InquiryItem {
  id           Int          @id @default(autoincrement())
  inquiryId    Int
  inquiry      Inquiry      @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  productId    Int
  product      Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  diameter     Float?
  diameterUnit DiameterUnit
  quantity     Float
  unit         String       @default("m")
  notes        String?

  @@index([inquiryId])
  @@index([productId])
}

enum InquiryStatus {
  NEW
  REVIEWING
  QUOTED
  NEGOTIATING
  WON
  LOST
}

enum DiameterUnit {
  MM
  INCH
}

enum TechnicalDataStatus {
  UNREVIEWED
  NEEDS_VERIFICATION
  VERIFIED
}

model Admin {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}
