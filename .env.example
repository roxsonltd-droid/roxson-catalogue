# Environment variables (copy to .env and fill in)

# SQLite database file (relative to prisma/ folder)
DATABASE_URL="file:./dev.db"

# NextAuth v5 — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_TRUST_HOST="true"

# Default admin (used by prisma/seed.ts)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123"

# Resend — https://resend.com/api-keys
RESEND_API_KEY=""

# Cloudinary — https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

RESEND_FROM_EMAIL="onboarding@resend.dev"

# Contact form recipient
CONTACT_EMAIL="roxson.ltd@gmail.com"
